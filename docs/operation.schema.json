{
  "$defs": {
    "Approve": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "action": {
          "const": "approve",
          "title": "Action",
          "type": "string"
        },
        "queue_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Queue Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "create",
            "update"
          ],
          "title": "Mode",
          "type": "string"
        },
        "entity": {
          "discriminator": {
            "mapping": {
              "budget": "#/$defs/Budget",
              "experience": "#/$defs/Experience",
              "food": "#/$defs/Food",
              "rating": "#/$defs/Rating",
              "region": "#/$defs/Region",
              "restaurant": "#/$defs/Restaurant",
              "transport": "#/$defs/Transport"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "$ref": "#/$defs/Food"
            },
            {
              "$ref": "#/$defs/Restaurant"
            },
            {
              "$ref": "#/$defs/Experience"
            },
            {
              "$ref": "#/$defs/Transport"
            },
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "$ref": "#/$defs/Rating"
            }
          ],
          "title": "Entity"
        },
        "target_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "expected_hash": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Hash"
        },
        "field_sources": {
          "additionalProperties": {
            "items": {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 30,
            "type": "array"
          },
          "propertyNames": {
            "maxLength": 2000,
            "minLength": 1
          },
          "title": "Field Sources",
          "type": "object"
        },
        "distinct_from": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "maxItems": 500,
          "title": "Distinct From",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "request_id",
        "reviewer",
        "reason",
        "action",
        "queue_id",
        "mode",
        "entity"
      ],
      "title": "Approve",
      "type": "object"
    },
